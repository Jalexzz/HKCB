{
  "expo": {
    "name": "HKCallBlocker",
    "slug": "HKCallBlocker",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hkcallblocker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jalexzzStudio.hkCallBlocker",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jalexzzStudio.hkCallBlocker"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.jalexzzStudio.hkCallBlocker.call-directory",
                  "targetName": "calldirectory",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jalexzzStudio.hkCallBlocker"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "155343e3-b1b0-428c-84dc-86976f41274f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/155343e3-b1b0-428c-84dc-86976f41274f"
    }
  }
}